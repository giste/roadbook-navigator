<?xml version="1.0" encoding="utf-8"?>
<!-- Map strings (English, default). -->
<resources>
    <!-- Shown in place of the map when no offline map is installed. -->
    <string name="map_no_maps">No maps installed</string>
    <!-- Shown in place of the map when map files are installed but none can be read. -->
    <string name="map_unreadable_maps">The installed maps cannot be read</string>
    <!-- Title of the map manager screen. -->
    <string name="map_manager_title">Maps</string>
    <!-- Shown in the map manager when the folder that holds the maps cannot be read. -->
    <string name="map_manager_folder_unreadable">The map folder cannot be read</string>
    <!-- Title of the dialog that confirms deleting a map file. %1$s is the file name. -->
    <string name="map_manager_delete_title">Delete %1$s?</string>
    <!-- Shown briefly when a map file could not be deleted. %1$s is the file name. -->
    <string name="map_manager_delete_failed">%1$s could not be deleted</string>
    <!-- Title of the map downloader screen, which lists the maps on the download site. -->
    <string name="map_downloader_title">Download maps</string>
    <!-- Shown in the map downloader when the download site cannot be reached. -->
    <string name="map_downloader_no_connection">Cannot reach the map site. Check the connection.</string>
    <!-- Shown in the map downloader when the download site answers with an error. -->
    <string name="map_downloader_server_error">The map site answered with an error</string>
    <!-- Shown in the map downloader when the download site's list of maps cannot be read. -->
    <string name="map_downloader_unreadable_listing">The map site\'s list cannot be read</string>
    <!-- Shown in the map downloader when a folder of the download site holds no maps. -->
    <string name="map_downloader_empty">No maps in this folder</string>
    <!--
      Credit for the map data, required by its license (ODbL). Shown in a corner of the map. Legally
      fixed text: the OpenStreetMap Foundation's attribution guidelines name "© OpenStreetMap" as
      an accepted form, so it is not translated (AGENTS.md §8).
    -->
    <string name="map_attribution" translatable="false">© OpenStreetMap</string>
</resources>
