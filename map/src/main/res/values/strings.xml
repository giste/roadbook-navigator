<?xml version="1.0" encoding="utf-8"?>
<!-- Map strings (English, default). -->
<resources>
    <!-- Shown in place of the map when no offline map is installed. -->
    <string name="map_no_maps">No maps installed</string>
    <!-- Shown in place of the map when map files are installed but none can be read. -->
    <string name="map_unreadable_maps">The installed maps cannot be read</string>
    <!-- Title of the map manager screen. -->
    <string name="map_manager_title">Maps</string>
    <!-- Shown in the map manager when the folder that holds the maps cannot be read. -->
    <string name="map_manager_folder_unreadable">The map folder cannot be read</string>
    <!-- Title of the dialog that confirms deleting a map file. %1$s is the file name. -->
    <string name="map_manager_delete_title">Delete %1$s?</string>
    <!-- Shown briefly when a map file could not be deleted. %1$s is the file name. -->
    <string name="map_manager_delete_failed">%1$s could not be deleted</string>
    <!-- Title of the map downloader screen, which lists the maps on the download site. -->
    <string name="map_downloader_title">Download maps</string>
    <!-- Shown in the map downloader when the download site cannot be reached. -->
    <string name="map_downloader_no_connection">Cannot reach the map site. Check the connection.</string>
    <!-- Shown in the map downloader when the download site answers with an error. -->
    <string name="map_downloader_server_error">The map site answered with an error</string>
    <!-- Shown in the map downloader when the download site's list of maps cannot be read. -->
    <string name="map_downloader_unreadable_listing">The map site\'s list cannot be read</string>
    <!-- Shown in the map downloader when a folder of the download site holds no maps. -->
    <string name="map_downloader_empty">No maps in this folder</string>
    <!-- Name of the notification channel of map downloads, shown in the system settings. -->
    <string name="map_download_channel_name">Map downloads</string>
    <!-- Title of the notification shown while a map downloads. %1$s is the map's file name. -->
    <string name="map_download_notification_title">Downloading %1$s</string>
    <!-- Text of the download notification. %1$s is the size downloaded, %2$s the map's size, e.g. "120 MB of 812 MB". -->
    <string name="map_download_notification_progress">%1$s of %2$s</string>
    <!-- Action of the download notification that stops the download. -->
    <string name="map_download_notification_cancel">Cancel</string>
    <!-- Title of the dialog shown before a download that would use mobile data. -->
    <string name="map_download_mobile_data_title">Not on Wi-Fi</string>
    <!-- Text of the mobile data dialog. %1$s is the map's file name. Its buttons are icons: mobile data, Wi-Fi and close. -->
    <string name="map_download_mobile_data_message">Download %1$s now with mobile data, or wait for Wi-Fi? Mobile data then applies to the maps already waiting too.</string>
    <!-- Text of the mobile data dialog when several map updates are to be downloaded. %1$d is how many. Its buttons are icons: mobile data, Wi-Fi and close. -->
    <plurals name="map_download_mobile_data_message_several">
        <item quantity="one">Download the update of %1$d map now with mobile data, or wait for Wi-Fi? Mobile data then applies to the maps already waiting too.</item>
        <item quantity="other">Download the updates of %1$d maps now with mobile data, or wait for Wi-Fi? Mobile data then applies to the maps already waiting too.</item>
    </plurals>
    <!-- Title of the dialog that confirms stopping a map download. %1$s is the map's file name. -->
    <string name="map_download_cancel_title">Stop downloading %1$s?</string>
    <!-- Shown under a map in the map downloader when the download site does not send it. -->
    <string name="map_download_failed_server">The map site did not send it</string>
    <!-- Shown under a map in the map downloader when the device has not enough space for it. -->
    <string name="map_download_failed_space">Not enough free space</string>
    <!-- Shown under a map in the map downloader when the downloaded map cannot be read. -->
    <string name="map_download_failed_unreadable">The downloaded map cannot be read</string>
    <!-- Shown under a map in the map downloader when it cannot be saved on the device. -->
    <string name="map_download_failed_storage">The map cannot be saved</string>
    <!--
      Credit for the map data, required by its license (ODbL). Shown in a corner of the map. Legally
      fixed text: the OpenStreetMap Foundation's attribution guidelines name "© OpenStreetMap" as
      an accepted form, so it is not translated (AGENTS.md §8).
    -->
    <string name="map_attribution" translatable="false">© OpenStreetMap</string>
</resources>
