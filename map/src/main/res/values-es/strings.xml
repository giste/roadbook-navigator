<?xml version="1.0" encoding="utf-8"?>
<!-- Map strings (Spanish). -->
<resources>
    <!-- Shown in place of the map when no offline map is installed. -->
    <string name="map_no_maps">No hay mapas instalados</string>
    <!-- Shown in place of the map when map files are installed but none can be read. -->
    <string name="map_unreadable_maps">No se pueden leer los mapas instalados</string>
    <!-- Title of the map manager screen. -->
    <string name="map_manager_title">Mapas</string>
    <!-- Shown in the map manager when the folder that holds the maps cannot be read. -->
    <string name="map_manager_folder_unreadable">No se puede leer la carpeta de mapas</string>
    <!-- Title of the dialog that confirms deleting a map file. %1$s is the file name. -->
    <string name="map_manager_delete_title">¿Borrar %1$s?</string>
    <!-- Shown briefly when a map file could not be deleted. %1$s is the file name. -->
    <string name="map_manager_delete_failed">No se ha podido borrar %1$s</string>
    <!-- Title of the map downloader screen, which lists the maps on the download site. -->
    <string name="map_downloader_title">Descargar mapas</string>
    <!-- Shown in the map downloader when the download site cannot be reached. -->
    <string name="map_downloader_no_connection">No se puede conectar con la web de mapas. Comprueba la conexión.</string>
    <!-- Shown in the map downloader when the download site answers with an error. -->
    <string name="map_downloader_server_error">La web de mapas ha respondido con un error</string>
    <!-- Shown in the map downloader when the download site's list of maps cannot be read. -->
    <string name="map_downloader_unreadable_listing">No se puede leer la lista de la web de mapas</string>
    <!-- Shown in the map downloader when a folder of the download site holds no maps. -->
    <string name="map_downloader_empty">No hay mapas en esta carpeta</string>
    <!-- Name of the notification channel of map downloads, shown in the system settings. -->
    <string name="map_download_channel_name">Descargas de mapas</string>
    <!-- Title of the notification shown while a map downloads. %1$s is the map's file name. -->
    <string name="map_download_notification_title">Descargando %1$s</string>
    <!-- Text of the download notification. %1$s is the size downloaded, %2$s the map's size. -->
    <string name="map_download_notification_progress">%1$s de %2$s</string>
    <!-- Shown under a map in the map downloader when the download site does not send it. -->
    <string name="map_download_failed_server">La web de mapas no lo ha enviado</string>
    <!-- Shown under a map in the map downloader when the device has not enough space for it. -->
    <string name="map_download_failed_space">No hay espacio libre suficiente</string>
    <!-- Shown under a map in the map downloader when the downloaded map cannot be read. -->
    <string name="map_download_failed_unreadable">El mapa descargado no se puede leer</string>
    <!-- Shown under a map in the map downloader when it cannot be saved on the device. -->
    <string name="map_download_failed_storage">El mapa no se puede guardar</string>
</resources>
