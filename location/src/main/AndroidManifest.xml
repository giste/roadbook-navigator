<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        GpsLocationRepository reads the GPS provider, which needs precise location. Android 12+
        only shows the precise option when coarse location is requested together with it.
        These are merged into the manifest of every app that uses :location.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- GPS is used when present, but the app can still be installed without it. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
</manifest>
