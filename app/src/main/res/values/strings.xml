<?xml version="1.0" encoding="utf-8"?>
<!-- App strings (English, default). -->
<resources>
    <string name="app_name">Roadbook Navigator</string>

    <!-- Precise location permission, shown by the core permission gate -->
    <string name="app_permission_location_action_allow">Allow location</string>
    <string name="app_permission_location_message">Roadbook Navigator uses your precise location to measure distances and to center the map. It is only used while the app is open and the screen is on.</string>
    <string name="app_permission_location_permanently_denied_message">Location access is turned off. Open the settings, go to Permissions, Location, choose \"Allow only while using the app\" and turn on \"Use precise location\".</string>
    <string name="app_permission_location_rationale">Without precise location, the odometer cannot measure distances. When asked, choose \"Precise\" and \"While using the app\".</string>
    <string name="app_permission_location_title">Precise location needed</string>
    <!-- Odometer on the dashboard: shown instead of a distance until it is read from storage -->
    <string name="app_odometer_value_loading">–</string>
    <!-- Odometer controls: the dialogs opened by long-pressing a distance -->
    <string name="app_odometer_set_partial_title">Set partial</string>
    <!-- A distance in kilometers, e.g. the typed partial: %1$s is the number -->
    <string name="app_odometer_kilometers">%1$s km</string>
    <string name="app_odometer_reset_all_title">Reset distances?</string>
    <string name="app_odometer_reset_all_message">The partial and the total will be set to zero.</string>
    <string name="app_odometer_reset_all_confirm">Reset</string>
    <string name="app_action_set">Set</string>
    <string name="app_action_cancel">Cancel</string>
</resources>
