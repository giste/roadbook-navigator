<?xml version="1.0" encoding="utf-8"?>
<!-- App strings (English, default). -->
<resources>
    <string name="app_name">Roadbook Navigator</string>

    <!-- Precise location permission, shown by the core permission gate -->
    <string name="app_permission_location_action_allow">Allow location</string>
    <string name="app_permission_location_message">Roadbook Navigator uses your precise location to measure distances and to center the map. It is only used while the app is open and the screen is on.</string>
    <string name="app_permission_location_permanently_denied_message">Location access is turned off. Open the settings, go to Permissions, Location, choose \"Allow only while using the app\" and turn on \"Use precise location\".</string>
    <string name="app_permission_location_rationale">Without precise location, the odometer cannot measure distances. When asked, choose \"Precise\" and \"While using the app\".</string>
    <string name="app_permission_location_title">Precise location needed</string>
    <!-- Odometer on the dashboard: shown instead of a distance until it is read from storage -->
    <string name="app_odometer_value_loading">–</string>
    <!-- Odometer controls: the dialogs opened by long-pressing a distance -->
    <string name="app_odometer_set_partial_title">Set partial</string>
    <!-- A distance in kilometers, e.g. the typed partial: %1$s is the number -->
    <string name="app_odometer_kilometers">%1$s km</string>
    <string name="app_odometer_reset_all_title">Reset distances?</string>
    <string name="app_odometer_reset_all_message">The partial and the total will be set to zero.</string>
    <string name="app_odometer_reset_all_confirm">Reset</string>
    <string name="app_action_set">Set</string>
    <string name="app_action_cancel">Cancel</string>

    <!-- About screen, opened from the settings -->
    <string name="app_about_title">About</string>
    <!-- The app's version: %1$s is the version name, e.g. 1.0 -->
    <string name="app_about_version">Version %1$s</string>
    <string name="app_about_app_licence">Roadbook Navigator is free software, under the GNU General Public License, version 3 or later.</string>
    <!-- A link to a licence's full text -->
    <string name="app_about_app_licence_link">Read the licence</string>
    <string name="app_about_section_map_data">Map data</string>
    <!-- Fixed: the attribution OpenStreetMap's licence (ODbL) and attribution guidelines require, in these words. -->
    <string name="app_about_osm_attribution" translatable="false">© OpenStreetMap contributors</string>
    <string name="app_about_osm_licence">The map data is available under the Open Database License.</string>
    <!-- A link to OpenStreetMap's copyright and licence page -->
    <string name="app_about_osm_copyright_link">Copyright and licence</string>
    <string name="app_about_section_map_renderer">Map renderer</string>
    <string name="app_about_vtm">The map is drawn with VTM, from the mapsforge project, under the GNU Lesser General Public License, version 3 or later.</string>
    <string name="app_about_vtm_link">VTM website</string>
    <string name="app_about_section_libraries">Open-source libraries</string>
    <string name="app_about_libraries_hint">Tap a library to read its licence.</string>
    <string name="app_about_libraries_unavailable">The list of libraries couldn\'t be read.</string>
    <!-- A library's version and licences: %1$s is the version, %2$s the licence names -->
    <string name="app_about_library_details">%1$s · %2$s</string>
    <!-- Shown when no app on the device can open a link -->
    <string name="app_about_link_failed">No app can open this link.</string>
</resources>
