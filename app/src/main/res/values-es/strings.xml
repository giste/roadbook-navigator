<?xml version="1.0" encoding="utf-8"?>
<!-- App strings (Spanish, used for every Spanish locale). Every key in values/strings.xml must exist here. -->
<resources>
    <string name="app_name">Roadbook Navigator</string>

    <!-- Precise location permission, shown by the core permission gate -->
    <string name="app_permission_location_action_allow">Permitir ubicación</string>
    <string name="app_permission_location_title">Se necesita la ubicación precisa</string>
    <string name="app_permission_location_message">Roadbook Navigator usa tu ubicación precisa para medir distancias y centrar el mapa. Solo se usa mientras la aplicación está abierta y la pantalla encendida.</string>
    <string name="app_permission_location_rationale">Sin la ubicación precisa, el cuentakilómetros no puede medir distancias. Cuando se te pregunte, elige \"Precisa\" y \"Mientras se usa la aplicación\".</string>
    <string name="app_permission_location_permanently_denied_message">El acceso a la ubicación está desactivado. Abre los ajustes, ve a Permisos, Ubicación, elige \"Permitir solo mientras se usa la aplicación\" y activa \"Usar ubicación precisa\".</string>
    <!-- Odometer on the dashboard: shown instead of a distance until it is read from storage -->
    <string name="app_odometer_value_loading">–</string>
    <!-- Odometer controls: the dialogs opened by long-pressing a distance -->
    <string name="app_odometer_set_partial_title">Fijar parcial</string>
    <string name="app_odometer_set_partial_field_label">Nuevo parcial</string>
    <!-- Unit after the typed partial -->
    <string name="app_odometer_unit_km">km</string>
    <string name="app_odometer_set_partial_error_not_a_number">Introduce una distancia en kilómetros, como 12,35</string>
    <!-- %1$s is the largest partial, e.g. 999,99 -->
    <string name="app_odometer_set_partial_error_too_large">El parcial puede ser como máximo %1$s km</string>
    <plurals name="app_odometer_set_partial_error_too_many_decimals">
        <item quantity="one">Usa como máximo %1$d decimal</item>
        <item quantity="many">Usa como máximo %1$d decimales</item>
        <item quantity="other">Usa como máximo %1$d decimales</item>
    </plurals>
    <string name="app_odometer_reset_all_title">¿Poner las distancias a cero?</string>
    <string name="app_odometer_reset_all_message">El parcial y el total se pondrán a cero.</string>
    <string name="app_odometer_reset_all_confirm">Poner a cero</string>
    <string name="app_action_set">Fijar</string>
    <string name="app_action_cancel">Cancelar</string>
</resources>
